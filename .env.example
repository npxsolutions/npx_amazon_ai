# URL of the n8n "Dashboard Data API (39)" webhook, production URL, no trailing slash and no query string.
# Example: https://npxwholesale.app.n8n.cloud/webhook/dashboard-api
DASHBOARD_API_URL=

# Shared secret the webhook checks (sent as an X-Dashboard-Key header). Ask Claude/n8n for the current value
# if you don't have it - it's set in the "Check Auth" node of the Dashboard Data API (39) workflow.
DASHBOARD_API_KEY=
