# URL of the n8n "Dashboard Data API (39)" webhook, production URL, no trailing slash and no query string.
# Example: https://npxwholesale.app.n8n.cloud/webhook/dashboard-api
DASHBOARD_API_URL=

# URL of the n8n "Dashboard Actions (40)" webhook - handles approve/reject clicks from the dashboard.
# Example: https://npxwholesale.app.n8n.cloud/webhook/dashboard-action
DASHBOARD_ACTION_URL=

# Shared secret both webhooks check (sent as an X-Dashboard-Key header). Ask Claude/n8n for the current value
# if you don't have it - it's set in the "Check Auth" node of each workflow.
DASHBOARD_API_KEY=

# BF Direct Dispatch tab: the Supabase edge function "bf-dd-data" and its access token (FUNCTIONS_TOKEN secret in Supabase).
# Example: https://<project-ref>.supabase.co/functions/v1/bf-dd-data
BF_DD_API_URL=
BF_DD_API_KEY=
